      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"attachment\",\"keepMoving\":true,\"attachment\":{\"type\":\"video\",\"url\":\"https://media.vlab.digital/a/93b7bfab-8fdb-472b-864e-a3bc7a59a3b6/2025-02-13%2000-13-42.mp4\"}}"
