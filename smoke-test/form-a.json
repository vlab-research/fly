          }
        },
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "test_handoff" }
          },
          "condition": {
            "op": "always",
            "vars": []
          }
        }
      ]
    },
    {
      "type": "field",
      "ref": "payment_wait",
      "actions": [
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "payment_success" }
          },
          "condition": {
            "op": "equal",
            "vars": [
              { "type": "hidden", "value": "e_payment_reloadly_success" },
