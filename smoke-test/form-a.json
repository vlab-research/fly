      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"attachment\",\"keepMoving\":true,\"attachment\":{\"type\":\"image\",\"attachment_id\":\"1658615935222752\"}}"
