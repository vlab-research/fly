      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"attachment\",\"keepMoving\":true,\"attachment\":{\"type\":\"image\",\"url\":\"https://staging.media.vlab.digital/a/4122f8d3-51e9-4c6c-9746-f27747333a74/IMG_1236.jpeg\"}}"
      }
    },
    {
      "type": "statement",
      "ref": "media_asset_repeat_staging",
      "title": "🖼️ [STAGING] The SAME staging image asset again — identical UUID to the field above, on purpose. This second send is the only proof that the handle is being reused rather than silently falling back to a fresh by-URL send every time.",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"attachment\",\"keepMoving\":true,\"attachment\":{\"type\":\"image\",\"url\":\"https://staging.media.vlab.digital/a/4122f8d3-51e9-4c6c-9746-f27747333a74/IMG_1236.jpeg\"}}"
      }
    },
    {
      "type": "statement",
      "ref": "media_asset_video_staging",
      "title": "🎥 [STAGING] A VIDEO sent by a dashboard asset URL on STAGING media storage — the modern upload path, non-image branch (≤16MB MP4/3GPP per §11.5).",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"attachment\",\"keepMoving\":true,\"attachment\":{\"type\":\"video\",\"url\":\"https://staging.media.vlab.digital/a/c8154af4-4554-4f48-bdb2-a8f0c8ecdd6b/2026-06-09%2018-06-31.mp4\"}}"
      }
    },
    {
      "type": "statement",
      "ref": "media_asset_file_staging",
      "title": "📄 [STAGING] A FILE (PDF) sent by a dashboard asset URL on STAGING media storage — the modern upload path, document branch (≤100MB per §11.5).",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"attachment\",\"keepMoving\":true,\"attachment\":{\"type\":\"file\",\"url\":\"https://staging.media.vlab.digital/a/079422ed-d32e-458f-8daa-61ff45c56004/0.Amdt%231-PO-43354893%20(Virtual%20Lab).pdf\"}}"
      }
