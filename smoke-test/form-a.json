{
  "title": "Fly Smoke Test - Part A",
  "workspace": {
    "href": "https://api.typeform.com/workspaces/red6P2"
  },
  "fields": [
    {
      "type": "statement",
      "ref": "welcome",
      "title": "Welcome to the Fly Smoke Test! This survey tests core Fly features: logic jumps, payments, media messages, video webviews + moviehouse events, timeouts, stitches, and more.",
      "properties": {
        "hide_marks": false,
        "button_text": "Start",
        "description": "{\"type\":\"attachment\",\"keepMoving\":true,\"attachment\":{\"type\":\"image\",\"url\":\"https://i.imgur.com/ZSHauqq.png\"}}"
      }
    },
    {
      "type": "multiple_choice",
      "ref": "favorite_color",
      "title": "What is your favorite color?\n- A. Red\n- B. Blue\n- C. Green",
      "properties": {
        "choices": [
          { "label": "A", "ref": "choice_red" },
          { "label": "B", "ref": "choice_blue" },
          { "label": "C", "ref": "choice_green" }
        ],
        "allow_multiple_selection": false,
        "vertical_alignment": true
      },
      "validations": { "required": false }
    },
    {
      "type": "short_text",
      "ref": "why_red",
      "title": "Why do you like the color red?",
      "validations": { "required": false }
    },
    {
      "type": "statement",
      "ref": "interesting_choice",
      "title": "Interesting choice!",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue"
      }
    },
    {
      "type": "number",
      "ref": "siblings",
      "title": "How many siblings do you have?",
      "validations": { "required": false }
    },
    {
      "type": "multiple_choice",
      "ref": "test_payment",
      "title": "Would you like to test the payment feature?",
      "properties": {
        "choices": [
          { "label": "Yes", "ref": "choice_payment_yes" },
          { "label": "No", "ref": "choice_payment_no" }
        ],
        "allow_multiple_selection": false,
        "vertical_alignment": true
      },
      "validations": { "required": false }
    },
    {
      "type": "multiple_choice",
      "ref": "operator",
      "title": "Please select your mobile network operator. For testing, select MTN Nigeria.",
      "properties": {
        "choices": [
          { "label": "MTN Nigeria" },
          { "label": "Airtel" },
          { "label": "Glo" },
          { "label": "9mobile" }
        ],
        "allow_multiple_selection": false,
        "vertical_alignment": true
      },
      "validations": { "required": false }
    },
    {
      "type": "phone_number",
      "ref": "phone",
      "title": "Enter your phone number. For testing, use +2348061147388 (MTN Nigeria).",
      "properties": {
        "default_country_code": "ng"
      },
      "validations": { "required": false }
    },
    {
      "type": "statement",
      "ref": "payment_wait",
      "title": "Processing 300 NGN mobile credit payment...",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"wait\",\"wait\":{\"type\":\"external\",\"value\":{\"type\":\"payment:reloadly\",\"id\":\"smokepay1\"}},\"payment\":{\"provider\":\"reloadly\",\"key\":\"vlab\",\"details\":{\"number\":\"{{field:phone}}\",\"amount\":300,\"country\":\"NG\",\"operator\":\"{{field:operator}}\",\"tolerance\":0,\"id\":\"smokepay1\"}}}"
      }
    },
    {
      "type": "statement",
      "ref": "payment_success",
      "title": "Payment succeeded! 300 NGN mobile credit has been sent to your number.",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue"
      }
    },
    {
      "type": "statement",
      "ref": "payment_failure",
      "title": "Payment failed. Error: {{hidden:e_payment_reloadly_error_message}}",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue"
      }
    },
    {
      "type": "multiple_choice",
      "ref": "try_again",
      "title": "Would you like to try again with a different number?",
      "properties": {
        "choices": [
          { "label": "Yes", "ref": "choice_yes" },
          { "label": "No", "ref": "choice_no" }
        ],
        "allow_multiple_selection": false,
        "vertical_alignment": true
      },
      "validations": { "required": false }
    },
    {
      "type": "multiple_choice",
      "ref": "test_handoff",
      "title": "Would you like to test the thread control handoff feature?",
      "properties": {
        "choices": [
          { "label": "Yes", "ref": "choice_handoff_yes" },
          { "label": "No", "ref": "choice_handoff_no" }
        ],
        "allow_multiple_selection": false,
        "vertical_alignment": true
      },
      "validations": { "required": false }
    },
    {
      "type": "statement",
      "ref": "handoff_statement",
      "title": "Now testing thread control handoff. The Smoke Echo app is about to take over this conversation — say something back to it, and it'll hand you right back to me.",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"handoff\",\"handoff\":{\"target_app_id\":\"976665718578167\",\"mode\":\"wait\",\"metadata\":{\"check\":\"smoke_test\"}}}"
      }
    },
    {
      "type": "statement",
      "ref": "handoff_result",
      "title": "Handoff complete! The echo app heard you say \"{{hidden:e_handover_metadata_echo_text}}\" (status: {{hidden:e_handover_metadata_smoke_echo}}) and handed control back to me.",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue"
      }
    },
    {
      "type": "multiple_choice",
      "ref": "test_utility",
      "title": "Would you like to test Facebook UTILITY template messages? (Choices must match the buttons approved on this page — see the smoke-test README before answering Yes on a new page.)",
      "properties": {
        "choices": [
          { "label": "Yes", "ref": "choice_test_utility_yes" },
          { "label": "No", "ref": "choice_test_utility_no" }
        ],
        "allow_multiple_selection": false,
        "vertical_alignment": true
      },
      "validations": { "required": false }
    },
    {
      "type": "multiple_choice",
      "ref": "utility_message",
      "title": "Now testing utility template messages. This should arrive as a Facebook UTILITY template (not plain text).",
      "properties": {
        "description": "{\"type\":\"utility_message\",\"template\":\"recontact\",\"language\":\"en_US\",\"params\":[\"300 NGN\"]}",
        "choices": [
          { "label": "OK!", "ref": "choice_utility_continue" }
        ],
        "allow_multiple_selection": false,
        "vertical_alignment": true
      },
      "validations": { "required": false }
    },
    {
      "type": "multiple_choice",
      "ref": "test_environment",
      "title": "🌐 Which environment are you testing right now? Asked once, up front: it selects both the attachment_id image (ids are scoped to the page that uploaded them) and the matching moviehouse video player.",
      "properties": {
        "choices": [
          { "label": "Production", "ref": "choice_env_prod" },
          { "label": "Staging", "ref": "choice_env_staging" }
        ],
        "allow_multiple_selection": false,
        "vertical_alignment": true
      },
      "validations": { "required": false }
    },
    {
      "type": "multiple_choice",
      "ref": "test_attachments",
      "title": "📎 Would you like to test bot-sent media attachments (video, PDF, image)? This sends three files back to back and can take a few moments — expect a short pause after you tap Yes.",
      "properties": {
        "choices": [
          { "label": "Yes", "ref": "choice_test_attachments_yes" },
          { "label": "No", "ref": "choice_test_attachments_no" }
        ],
        "allow_multiple_selection": false,
        "vertical_alignment": true
      },
      "validations": { "required": false }
    },
    {
      "type": "statement",
      "ref": "media_video",
      "title": "🎥 Now testing rich media. Here's a VIDEO attachment sent by the bot:",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"attachment\",\"keepMoving\":true,\"attachment\":{\"type\":\"video\",\"url\":\"https://download.samplelib.com/mp4/sample-5s.mp4\"}}"
      }
    },
    {
      "type": "multiple_choice",
      "ref": "confirm_video",
      "title": "Did the VIDEO actually arrive? A failed send is reported and committed rather than retried, so the survey walks on regardless — answer honestly, this is the only signal.",
      "properties": {
        "choices": [
          { "label": "Yes", "ref": "choice_confirm_video_yes" },
          { "label": "No", "ref": "choice_confirm_video_no" }
        ],
        "allow_multiple_selection": false,
        "vertical_alignment": true
      },
      "validations": { "required": false }
    },
    {
      "type": "statement",
      "ref": "media_file",
      "title": "📄 And here's a FILE (PDF) attachment sent by the bot:",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"attachment\",\"keepMoving\":true,\"attachment\":{\"type\":\"file\",\"url\":\"https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf\"}}"
      }
    },
    {
      "type": "multiple_choice",
      "ref": "confirm_file",
      "title": "Did the PDF actually arrive?",
      "properties": {
        "choices": [
          { "label": "Yes", "ref": "choice_confirm_file_yes" },
          { "label": "No", "ref": "choice_confirm_file_no" }
        ],
        "allow_multiple_selection": false,
        "vertical_alignment": true
      },
      "validations": { "required": false }
    },
    {
      "type": "statement",
      "ref": "media_attachment_id_prod",
      "title": "🖼️ And here's an IMAGE sent by attachment_id (PRODUCTION) — pre-uploaded to the page rather than fetched from a URL:",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"attachment\",\"keepMoving\":true,\"attachment\":{\"type\":\"image\",\"attachment_id\":\"1434849748462496\"}}"
      }
    },
    {
      "type": "statement",
      "ref": "media_attachment_id_staging",
      "title": "🖼️ And here's an IMAGE sent by attachment_id (STAGING) — pre-uploaded to the page rather than fetched from a URL:",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"attachment\",\"keepMoving\":true,\"attachment\":{\"type\":\"image\",\"attachment_id\":\"1658615935222752\"}}"
      }
    },
    {
      "type": "multiple_choice",
      "ref": "confirm_attachment",
      "title": "Did the by-attachment_id IMAGE actually arrive? If not, the id is probably scoped to the other environment's page — check message-worker logs for \"Failed to load attachment from attachment ID\".",
      "properties": {
        "choices": [
          { "label": "Yes", "ref": "choice_confirm_attachment_yes" },
          { "label": "No", "ref": "choice_confirm_attachment_no" }
        ],
        "allow_multiple_selection": false,
        "vertical_alignment": true
      },
      "validations": { "required": false }
    },
    {
      "type": "short_text",
      "ref": "send_picture",
      "title": "📸 Now testing INBOUND media. Please send me a picture — tap the attachment/camera button in Messenger and choose any photo.",
      "properties": {
        "description": "{\"type\":\"upload\",\"upload\":{\"type\":\"image\"}}"
      },
      "validations": { "required": false }
    },
    {
      "type": "statement",
      "ref": "picture_received",
      "title": "📸 Got your picture! The bot received it and stored the image URL: {{field:send_picture}}",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue"
      }
    },
    {
      "type": "statement",
      "ref": "movie_webview_prod",
      "title": "🎬 Testing in PRODUCTION. Now testing the video webview + moviehouse events — tap the button to open the production video player, then press ▶️ play. I'll react as soon as you start it.",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"webview\",\"url\":\"https://virtuallab-videos.netlify.app/?id=164118668&pageId={{hidden:pageid}}&userId={{hidden:id}}\",\"buttonText\":\"Watch test video\",\"responseMessage\":\"Tap ▶️ above and press play. I'll continue automatically once the video starts (or after 3 minutes if it doesn't).\",\"wait\":{\"op\":\"or\",\"vars\":[{\"type\":\"external\",\"value\":{\"type\":\"moviehouse:play\",\"id\":\"164118668\"}},{\"type\":\"timeout\",\"value\":\"3 minutes\"}]}}"
      }
    },
    {
      "type": "statement",
      "ref": "movie_webview_staging",
      "title": "🎬 Testing in STAGING. Now testing the video webview + moviehouse events — tap the button to open the staging video player, then press ▶️ play. I'll react as soon as you start it.",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"webview\",\"url\":\"https://staging--virtuallab-videos.netlify.app/?id=164118668&pageId={{hidden:pageid}}&userId={{hidden:id}}\",\"buttonText\":\"Watch test video\",\"responseMessage\":\"Tap ▶️ above and press play. I'll continue automatically once the video starts (or after 3 minutes if it doesn't).\",\"wait\":{\"op\":\"or\",\"vars\":[{\"type\":\"external\",\"value\":{\"type\":\"moviehouse:play\",\"id\":\"164118668\"}},{\"type\":\"timeout\",\"value\":\"3 minutes\"}]}}"
      }
    },
    {
      "type": "statement",
      "ref": "movie_watched",
      "title": "🎬 Reacting to your moviehouse:play event with logic — the bot received a PLAY event for video {{hidden:e_moviehouse_play_id}} and branched here. ✅",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue"
      }
    },
    {
      "type": "statement",
      "ref": "movie_timeout",
      "title": "No moviehouse:play event arrived within 3 minutes, so the timeout branch fired instead. Continuing anyway.",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue"
      }
    },
    {
      "type": "statement",
      "ref": "stitch_statement",
      "title": "Now testing stitch to Part B...",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"stitch\",\"stitch\":{\"form\":\"flysmokeb\"}}"
      }
    }
  ],
  "thankyou_screens": [
    {
      "ref": "default_tys",
      "title": "Thanks for completing the Fly Smoke Test!",
      "properties": {
        "show_button": false,
        "share_icons": false
      }
    }
  ],
  "hidden": [
    "id",
    "userid",
    "surveyid",
    "seed_2",
    "pageid",
    "e_payment_reloadly_success",
    "e_payment_reloadly_error_message",
    "e_handover_metadata_smoke_echo",
    "e_handover_metadata_echo_text",
    "e_moviehouse_play_id"
  ],
  "logic": [
    {
      "type": "field",
      "ref": "favorite_color",
      "actions": [
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "why_red" }
          },
          "condition": {
            "op": "is",
            "vars": [
              { "type": "field", "value": "favorite_color" },
              { "type": "choice", "value": "choice_red" }
            ]
          }
        },
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "interesting_choice" }
          },
          "condition": {
            "op": "always",
            "vars": []
          }
        }
      ]
    },
    {
      "type": "field",
      "ref": "why_red",
      "actions": [
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "siblings" }
          },
          "condition": {
            "op": "always",
            "vars": []
          }
        }
      ]
    },
    {
      "type": "field",
      "ref": "interesting_choice",
      "actions": [
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "siblings" }
          },
          "condition": {
            "op": "always",
            "vars": []
          }
        }
      ]
    },
    {
      "type": "field",
      "ref": "test_payment",
      "actions": [
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "operator" }
          },
          "condition": {
            "op": "is",
            "vars": [
              { "type": "field", "value": "test_payment" },
              { "type": "choice", "value": "choice_payment_yes" }
