        "choices": [
          { "label": "Yes", "ref": "choice_test_attachments_yes" },
          { "label": "No", "ref": "choice_test_attachments_no" }
        ],
        "allow_multiple_selection": false,
        "vertical_alignment": true
      },
      "validations": { "required": false }
    },
    {
      "type": "statement",
      "ref": "media_third_party_url",
      "title": "🖼️ First, an ordinary third-party image URL — not a dashboard asset, proving that plain third-party URLs still work unaccelerated (no handle, no mirroring). This is the only not-uploaded URL test in the survey besides the welcome screen, and the only media field SHARED by both environments: a third-party URL belongs to no environment. Everything after this is environment-specific.",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"attachment\",\"keepMoving\":true,\"attachment\":{\"type\":\"image\",\"url\":\"https://i.imgur.com/ZSHauqq.png\"}}"
      }
    },
    {
      "type": "statement",
      "ref": "media_legacy_attachment_id_prod",
      "title": "🖼️ [PRODUCTION] An IMAGE sent by a legacy attachment_id minted on the PRODUCTION page — the old pre-upload method, kept permanently for backwards compatibility since Meta offers no way to migrate an existing attachment_id into an asset. Attachment ids are page-scoped, so this id only works in production. Should work on Messenger; on WhatsApp it is expected to fail cleanly, since attachment ids were never supported there.",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"attachment\",\"keepMoving\":true,\"attachment\":{\"type\":\"image\",\"attachment_id\":\"1434849748462496\"}}"
      }
    },
    {
      "type": "statement",
      "ref": "media_asset_image_prod",
      "title": "🖼️ [PRODUCTION] An IMAGE sent by a dashboard asset URL on PRODUCTION media storage (media.vlab.digital) — the modern upload path. Asset rows live in one environment's database and bucket, so production sends production URLs.",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"attachment\",\"keepMoving\":true,\"attachment\":{\"type\":\"image\",\"url\":\"https://media.vlab.digital/a/5e8aa701-8c63-450e-af6f-bdbea6d7321f/IMG_1239.jpeg\"}}"
      }
    },
    {
      "type": "statement",
      "ref": "media_asset_repeat_prod",
      "title": "🖼️ [PRODUCTION] The SAME production image asset again — identical UUID to the field above, on purpose. This second send is the only proof that the handle is being reused rather than silently falling back to a fresh by-URL send every time.",
      "properties": {
        "hide_marks": false,
        "button_text": "Continue",
        "description": "{\"type\":\"attachment\",\"keepMoving\":true,\"attachment\":{\"type\":\"image\",\"url\":\"https://media.vlab.digital/a/5e8aa701-8c63-450e-af6f-bdbea6d7321f/IMG_1239.jpeg\"}}"
