  "thankyou_screens": [
    {
      "ref": "default_tys",
      "title": "Thanks for completing the Fly Smoke Test!",
      "properties": {
        "show_button": false,
        "share_icons": false
      }
    }
  ],
  "hidden": [
    "id",
    "userid",
    "surveyid",
    "seed_2",
    "pageid",
    "e_payment_reloadly_success",
    "e_payment_reloadly_error_message",
    "e_handover_metadata_smoke_echo",
    "e_handover_metadata_echo_text",
    "e_moviehouse_play_id"
  ],
  "logic": [
    {
      "type": "field",
      "ref": "favorite_color",
      "actions": [
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "why_red" }
          },
          "condition": {
            "op": "is",
            "vars": [
              { "type": "field", "value": "favorite_color" },
              { "type": "choice", "value": "choice_red" }
            ]
          }
        },
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "interesting_choice" }
          },
          "condition": {
            "op": "always",
            "vars": []
          }
        }
      ]
    },
    {
      "type": "field",
      "ref": "why_red",
      "actions": [
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "siblings" }
          },
          "condition": {
            "op": "always",
            "vars": []
          }
        }
      ]
    },
    {
      "type": "field",
      "ref": "interesting_choice",
      "actions": [
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "siblings" }
          },
          "condition": {
            "op": "always",
            "vars": []
          }
        }
      ]
    },
    {
      "type": "field",
      "ref": "test_payment",
      "actions": [
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "operator" }
          },
          "condition": {
            "op": "is",
            "vars": [
              { "type": "field", "value": "test_payment" },
              { "type": "choice", "value": "choice_payment_yes" }
            ]
          }
        },
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "test_handoff" }
          },
          "condition": {
            "op": "always",
            "vars": []
          }
        }
      ]
    },
    {
      "type": "field",
      "ref": "payment_wait",
      "actions": [
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "payment_success" }
          },
          "condition": {
            "op": "equal",
            "vars": [
              { "type": "hidden", "value": "e_payment_reloadly_success" },
              { "type": "constant", "value": "true" }
            ]
          }
        },
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "payment_failure" }
          },
          "condition": {
            "op": "always",
            "vars": []
          }
        }
      ]
    },
    {
      "type": "field",
      "ref": "payment_success",
      "actions": [
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "test_handoff" }
          },
          "condition": {
            "op": "always",
            "vars": []
          }
        }
      ]
    },
    {
      "type": "field",
      "ref": "try_again",
      "actions": [
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "operator" }
          },
          "condition": {
            "op": "is",
            "vars": [
              { "type": "field", "value": "try_again" },
              { "type": "choice", "value": "choice_yes" }
            ]
          }
        },
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "test_handoff" }
          },
          "condition": {
            "op": "always",
            "vars": []
          }
        }
      ]
    },
    {
      "type": "field",
      "ref": "test_handoff",
      "actions": [
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "handoff_statement" }
          },
          "condition": {
            "op": "is",
            "vars": [
              { "type": "field", "value": "test_handoff" },
              { "type": "choice", "value": "choice_handoff_yes" }
            ]
          }
        },
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "test_utility" }
          },
          "condition": {
            "op": "always",
            "vars": []
          }
        }
      ]
    },
    {
      "type": "field",
      "ref": "test_utility",
      "actions": [
        {
          "action": "jump",
          "details": {
            "to": { "type": "field", "value": "utility_message" }
          },
          "condition": {
            "op": "is",
            "vars": [
              { "type": "field", "value": "test_utility" },
