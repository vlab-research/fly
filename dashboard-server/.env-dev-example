# Committed template for the gitignored `.env` that docker-compose.yml reads.
#
#   cp dashboard-server/.env-dev-example dashboard-server/.env
#   cd dashboard-server && docker compose up -d
#
# LOCAL DEVELOPMENT ONLY. These are throwaway values for the MinIO and
# CockroachDB containers on your laptop and must never appear in a cluster.
#
# This is a SEPARATE FILE from `.env-example`, which is the template for the
# production/staging media secret (`dashboard-media`) and deliberately holds
# nothing but the two scoped service-account keys, left empty. Mixing the two
# would put a working root credential one copy-paste away from a cluster secret.
# See documentation/secrets.md.

# --- MinIO server (read by the minio and minio-init containers) -------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- dashboard-server media storage (planning/media-abstraction.md §4.7) ----
# These match config/index.js's STORAGE defaults, so the local stack works with
# nothing exported into your shell. In production every one of them is a plain
# value in devops/values/<env>.yaml; only the two S3 keys are secret.
#
# s3 | none — 'none' is a dev no-op that discards bytes, matching the exporter.
STORAGE_BACKEND=s3
MEDIA_BUCKET=media
# Fixed at 'a/': media.core.js derives the object key from it and media-proxy's
# path regex hard-codes the same segment. Any other value fails at boot.
MEDIA_PREFIX=a/
# In production this is https://media.vlab.digital — media-proxy's origin, which
# is deliberately NOT the dashboard's origin, so uploaded content cannot reach
# dashboard sessions (§4.6).
MEDIA_PUBLIC_BASE=http://localhost:9000/media
S3_ENDPOINT=http://localhost:9000
# MinIO ignores the region; the S3 protocol requires one.
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
