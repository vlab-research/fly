# Copy to secret.env (gitignored) and fill in the real Slack incoming-webhook
# URLs. secret.env is consumed by apply.sh; never commit real webhook URLs.
SLACK_WEBHOOK_WARNING=https://hooks.slack.com/services/REPLACE/ME/WARNING
SLACK_WEBHOOK_CRITICAL=https://hooks.slack.com/services/REPLACE/ME/CRITICAL
# ntfy publish token (write access to topic vlab-alerts). Create with:
#   kubectl -n monitoring exec deploy/ntfy -- ntfy token add alerts
NTFY_TOKEN=tk_REPLACE_ME
