APP_NAME='exporter'

# DATABASE_URL scheme MUST be postgres:// or postgresql://.
# libpq (and therefore psycopg) only recognises those two as connection URIs.
# Any other scheme -- including cockroachdb:// -- is parsed as a keyword/value
# DSN and fails at connect time with: invalid connection option "..."
DATABASE_URL=postgres://root@localhost:26257/chatroach?sslmode=disable

# Storage backend: `google` (GCS), `s3` (MinIO), or unset for a dev no-op.
STORAGE_BACKEND=s3
S3_BUCKET_NAME=exports
S3_HOST=localhost:9000
S3_SSL_ENABLED=false
S3_ACCESS_KEY=
S3_SECRET_KEY=

# NOTE: the exporter no longer consumes Kafka -- it polls the export_status
# table (see exporter/README.md). Any KAFKA_* vars still set in the Helm values
# are vestigial and unread.
