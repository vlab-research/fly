# bouncer secrets. Copy to .env-staging / .env-production (gitignored) and apply:
#   devops/secrets.sh <vstag|vprod> bouncer bouncer/.env-<env>
#
# From the Cloudflare dashboard, Turnstile widget for this environment's host.
TURNSTILE_SECRET_KEY=0x4AAAAAAA-replace-me
# openssl rand -hex 32. MUST equal BOUNCER_HMAC_KEY in replybot/.env-<env>,
# which signs the links bouncer verifies. Different per environment.
BOUNCER_HMAC_KEY=replace-me
